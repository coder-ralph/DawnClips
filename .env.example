# Public values are exposed to the browser. Everything else is a server secret.
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Application (public)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (public publishable key, server secret)
# `npx clerk init` writes development keys to .env.local. Do not paste them here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook signing secret. The SDK reads CLERK_WEBHOOK_SIGNING_SECRET.
# Clerk Dashboard → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk
# Subscribe to user.created, user.updated, and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=
# Alias name from older notes. The app does not read this name.
# CLERK_WEBHOOK_SECRET=

# Supabase (URL and anon/publishable key are public; service role is a server secret)
# Use the project URL only, with no /rest/v1 suffix.
# The publishable key is the current name for the anon public key. Set one of them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (all server secrets except the public delivery URL)
# Used in Phase 2. Leave blank until upload work starts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public CDN origin. Use it only if the bucket is intentionally public.
# Private and unlisted clips never use this URL. A public bucket can still be
# fetched by anyone who learns an object key, so prefer a private bucket.
R2_PUBLIC_URL=
CLIP_MAX_BYTES=104857600
CLIP_UPLOAD_URL_TTL_SECONDS=900
CLIP_PLAYBACK_URL_TTL_SECONDS=3600

# Server-only. Comma-separated Clerk user IDs allowed to review reports and remove clips.
MODERATOR_CLERK_USER_IDS=
